<?xml version="1.0" encoding="utf-8"?>
<!-- VerifyPage — 校验操作界面 -->
<Page
    x:Class="CutX.GUI.Views.VerifyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource BgBrush}">

    <ScrollViewer Padding="0" Margin="0">
        <StackPanel Orientation="Vertical" Spacing="16" Margin="0,0,0,24">

            <TextBlock Text="校验 Verify" Style="{StaticResource SectionHeadingStyle}" />

            <!-- Manifest file picker -->
            <StackPanel Spacing="6">
                <TextBlock Text="清单文件 (.manifest.json)" Style="{StaticResource FieldLabelStyle}" />
                <Border x:Name="VerifyDropZone"
                        Style="{StaticResource DropZoneStyle}"
                        AllowDrop="True"
                        DragOver="VerifyDrop_DragOver"
                        Drop="VerifyDrop_Drop"
                        Tapped="VerifyDrop_Tapped">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <muxc:FontIcon Glyph="&#xE73E;" FontSize="28"
                                  Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="拖拽 .manifest.json 文件到此处"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,10,0,0" />
                        <TextBlock x:Name="VerifyFileText" Text="" FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Info note -->
            <Border Background="#1F1F22"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <muxc:FontIcon Glyph="&#xE946;" FontSize="14"
                              Foreground="{StaticResource InfoBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="校验不执行合并，仅验证所有分片的完整性。快速排查传输过程中损坏的分片。"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="480" />
                </StackPanel>
            </Border>

            <!-- CTA -->
            <Button x:Name="VerifyButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="▶ 开始校验"
                    Click="Verify_Click"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
