<?xml version="1.0" encoding="utf-8"?>
<!--
  SplitPage — 切割操作界面
  
  Structure:
    ┌──────────────────────────────────────┐
    │  切割 Split                           │  ← Section heading
    ├──────────────────────────────────────┤
    │  ┌─ Drop Zone ──────────────────────┐│
    │  │    📂  拖拽文件到此处              ││  ← Drag-and-drop area
    │  │      或点击浏览选择源文件          ││
    │  └──────────────────────────────────┘│
    │                                       │
    │  切割大小 [2G     ▼]  校验算法[md5 ▼] │  ← Parameter row
    │  输出目录 [留空=自动创建子目录    ]   │  ← Output dir + browse
    │  预览: cutx-ubuntu-server/            │  ← Live preview label
    │                                       │
    │           [ ▶ 开始切割 ]              │  ← Primary CTA
    └──────────────────────────────────────┘
-->
<Page
    x:Class="CutX.GUI.Views.SplitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BgBrush}">

    <ScrollViewer Padding="0" Margin="0">
        <StackPanel Orientation="Vertical" Spacing="16" Margin="0,0,0,24">

            <!-- Section heading -->
            <TextBlock Text="切割 Split" Style="{StaticResource SectionHeadingStyle}" />

            <!-- Drop Zone -->
            <Border x:Name="DropZone"
                    Style="{StaticResource DropZoneStyle}"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop"
                    Tapped="DropZone_Tapped">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <muxc:FontIcon Glyph="&#xE8B5;" FontSize="32"
                              Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="拖拽文件到此处"
                               FontSize="15" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,12,0,4" />
                    <TextBlock Text="或点击浏览选择源文件"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="SelectedFileText"
                              Text="" FontSize="13"
                              FontFamily="Cascadia Mono, Consolas"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Parameter row -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Chunk size -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="切割大小" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ChunkSizeCombo"
                              SelectedIndex="0"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource CardBrush}"
                              BorderBrush="{StaticResource StrokeBrush}"
                              CornerRadius="6">
                        <x:String>2G</x:String>
                        <x:String>1G</x:String>
                        <x:String>500M</x:String>
                        <x:String>100M</x:String>
                        <x:String>自定义...</x:String>
                    </ComboBox>
                </StackPanel>

                <!-- Hash algorithm -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="校验算法" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="HashAlgoCombo"
                              SelectedIndex="0"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource CardBrush}"
                              BorderBrush="{StaticResource StrokeBrush}"
                              CornerRadius="6">
                        <x:String>md5 (快速)</x:String>
                        <x:String>sha256 (安全)</x:String>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Output directory -->
            <StackPanel Spacing="6">
                <TextBlock Text="输出目录" Style="{StaticResource FieldLabelStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputDirText"
                             Grid.Column="0"
                             PlaceholderText="留空 = 自动创建 cutx-&lt;文件名&gt;/ 子目录"
                             Background="{StaticResource CardBrush}"
                             BorderBrush="{StaticResource StrokeBrush}"
                             CornerRadius="6"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="13" />
                    <Button x:Name="BrowseOutputBtn"
                            Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="浏览..."
                            Click="BrowseOutput_Click" />
                </Grid>
                <!-- Live preview of output path -->
                <TextBlock x:Name="OutputPreviewText"
                           Text="将创建 cutx-&lt;文件名&gt;/ 子目录"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="2,4,0,0" />
            </StackPanel>

            <!-- Primary CTA -->
            <Button x:Name="SplitButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="▶ 开始切割"
                    Click="Split_Click"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
