<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BgColor">          #1E1E1E</Color>
    <Color x:Key="PanelColor">      #252526</Color>
    <Color x:Key="CardColor">       #2D2D30</Color>
    <Color x:Key="CardHoverColor">  #323234</Color>
    <Color x:Key="StrokeColor">     #3E3E42</Color>
    <Color x:Key="StrokeBrightColor">#4E4E52</Color>
    <Color x:Key="AccentColor">     #4EC9B0</Color>
    <Color x:Key="AccentHoverColor">#5FD4BC</Color>
    <Color x:Key="AccentPressColor">#45B89F</Color>
    <Color x:Key="AccentDimColor">  #2A3F3A</Color>
    <Color x:Key="TextPrimaryColor">  #E0E0E0</Color>
    <Color x:Key="TextSecondaryColor">#9E9E9E</Color>
    <Color x:Key="TextMutedColor">    #6E6E6E</Color>
    <Color x:Key="SuccessColor">#4EC9B0</Color>
    <Color x:Key="WarningColor">#DCDCAA</Color>
    <Color x:Key="ErrorColor">  #F44747</Color>
    <Color x:Key="InfoColor">   #569CD6</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush"           Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush"        Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="CardBrush"         Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush"    Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush"       Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeBrightBrush"  Color="{StaticResource StrokeBrightColor}" />
    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressBrush"  Color="{StaticResource AccentPressColor}" />
    <SolidColorBrush x:Key="AccentDimBrush"     Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush"   Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush"     Color="{StaticResource InfoColor}" />

    <!-- Styles (simplified — no custom ControlTemplate) -->
    <Style x:Key="AccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background"       Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground"       Value="#1E1E1E" />
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="CornerRadius"    Value="6" />
        <Setter Property="MinHeight"        Value="40" />
        <Setter Property="Padding"          Value="24,8" />
        <Setter Property="FontWeight"      Value="SemiBold" />
        <Setter Property="FontSize"         Value="14" />
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background"      Value="{StaticResource CardBrush}" />
        <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="6" />
        <Setter Property="MinHeight"       Value="32" />
        <Setter Property="Padding"         Value="12,6" />
        <Setter Property="FontSize"        Value="13" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background"   Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush"  Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding"      Value="20,16" />
    </Style>

    <Style x:Key="DropZoneStyle" TargetType="Border">
        <Setter Property="Background"    Value="#1F1F22" />
        <Setter Property="BorderBrush"   Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius"  Value="8" />
        <Setter Property="Padding"       Value="24,32" />
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily">Cascadia Mono, Consolas, Courier New, monospace</Setter>
        <Setter Property="FontSize"   Value="12" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

</ResourceDictionary>
