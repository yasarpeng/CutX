<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow — Top-level shell
  
  Layout (top-to-bottom):
    ┌─────────────────────────────────────────────┐
    │  [Logo] CutX          切割 | 合并 | 校验 | 版本  │  ← TitleBar + NavTop
    ├─────────────────────────────────────────────┤
    │                                             │
    │              PAGE CONTENT                    │  ← Frame (switches per tab)
    │                                             │
    ├─────────────────────────────────────────────┤
    │  [▓▓▓▓▓▓░░░░░] 65% | Splitting ubuntu.img   │  ← Progress bar (shared)
    ├─────────────────────────────────────────────┤
    │  [日志 ▼] [全部▼]      [清空] [导出]         │  ← Log header
    │  14:23:01 [cutx] Splitting: ubuntu.img       │
    │  14:23:05 [cutx] ✓ Done! 50 parts...        │  ← Log list (monospace)
    └─────────────────────────────────────────────┘
-->
<Window
    x:Class="CutX.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Window.Resources>
        <!-- Log entry data template -->
        <DataTemplate x:Key="LogEntryTemplate">
            <TextBlock Style="{StaticResource MonoTextStyle}"
                       Foreground="{Binding LevelBrush}"
                       Text="{Binding DisplayText}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="48"  />   <!-- Top nav bar -->
            <RowDefinition Height="*"    />   <!-- Page content -->
            <RowDefinition Height="Auto" />   <!-- Progress bar -->
            <RowDefinition Height="Auto" />   <!-- Log panel -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Title bar + top navigation ═══ -->
        <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Logo + title -->
            <StackPanel Orientation="Horizontal"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Border Width="24" Height="24" CornerRadius="6"
                        Background="{StaticResource AccentBrush}">
                    <TextBlock Text="C" FontSize="14" FontWeight="Bold"
                               Foreground="#1E1E1E"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="CutX" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- Tab bar — NavigationView Top mode -->
            <muxc:NavigationView x:Name="NavView"
                                  Grid.Column="1"
                                  PaneDisplayMode="Top"
                                  IsBackButtonVisible="Collapsed"
                                  IsSettingsVisible="False"
                                  SelectionChanged="NavView_SelectionChanged"
                                  Background="Transparent">
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem Tag="Split"  Content="切割" />
                    <muxc:NavigationViewItem Tag="Merge"  Content="合并" />
                    <muxc:NavigationViewItem Tag="Verify"  Content="校验" />
                    <muxc:NavigationViewItem Tag="Version" Content="版本" />
                </muxc:NavigationView.MenuItems>
            </muxc:NavigationView>
        </Grid>

        <!-- ═══ ROW 1: Page content (Frame) ═══ -->
        <Frame x:Name="ContentFrame"
               Grid.Row="1"
               Background="{StaticResource BgBrush}"
               Padding="24,16,24,16" />

        <!-- ═══ ROW 2: Progress bar (shared across all pages) ═══ -->
        <Grid Grid.Row="2" Background="{StaticResource PanelBrush}"
              Padding="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="12">
                <muxc:ProgressBar x:Name="ProgressBar"
                                   Width="300"
                                   Height="4"
                                   CornerRadius="2"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                <TextBlock x:Name="ProgressText"
                           Text="就绪"
                           Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Chunk grid: visual representation of completed parts -->
            <!-- ItemsSource bound in code-behind; each item is a 8x8 Border -->
            <muxc:ItemsRepeater x:Name="ChunkGrid"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="10" MinItemHeight="10"
                                             MinRowSpacing="2" MinColumnSpacing="2" />
                </muxc:ItemsRepeater.Layout>
            </muxc:ItemsRepeater>
        </Grid>

        <!-- ═══ ROW 3: Log panel (collapsible) ═══ -->
        <muxc:Expander x:Name="LogExpander"
                  Grid.Row="3"
                  Header="日志"
                  IsExpanded="True"
                  Background="{StaticResource PanelBrush}"
                  HorizontalAlignment="Stretch"
                  BorderThickness="0,1,0,0"
                  BorderBrush="{StaticResource StrokeBrush}">
            <Grid Height="160">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />   <!-- Log toolbar -->
                    <RowDefinition Height="*"   />   <!-- Log list -->
                </Grid.RowDefinitions>

                <!-- Log toolbar -->
                <Grid Grid.Row="0" Padding="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="LogFilter"
                              Grid.Column="0"
                              SelectedIndex="0"
                              FontSize="12"
                              Width="100"
                              Background="Transparent">
                        <x:String>全部</x:String>
                        <x:String>成功</x:String>
                        <x:String>警告</x:String>
                        <x:String>错误</x:String>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="8">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="清空"
                                Click="ClearLog_Click" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="导出"
                                Click="ExportLog_Click" />
                    </StackPanel>
                </Grid>

                <!-- Log list -->
                <ListView x:Name="LogListView"
                          Grid.Row="1"
                          Background="{StaticResource CardBrush}"
                          Padding="8,4"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ItemTemplate="{StaticResource LogEntryTemplate}" />
            </Grid>
        </muxc:Expander>
    </Grid>

</Window>
